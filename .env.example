# Copy to .env.local for local work; never commit real values. Every variable here is validated in
# src/env.ts, and the build fails when one is missing. Set the same variables in CI
# (.github/workflows/ci.yml) and on the hosting provider.

# Production origin, no trailing slash: base for canonical URLs, the sitemap and social images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
